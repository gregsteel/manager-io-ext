#------------------------------------------
#deployment — secrets / data layout specific to this app
/secrets/*.env
!/secrets/*.env.example
/secrets/gmail/*.json
!/secrets/gmail/gcp-oauth.keys.json.example
# Bank-feed provider config saved by manager-mcp's /setup/bank-feeds UI
# (BASIQ_USERNAME/PASSWORD etc.) -- see manager-mcp/README.md's
# "Bank-feed providers" section. Never handwritten, never committed.
/secrets/manager/
# Read-only deploy key mounted into the webhook container (see README's
# "Webhook auto-deploy" section).
/secrets/webhook-ssh/
# FastMCP's OAuthProxy encrypted token store for manager-mcp/gmail-relay
# (registered clients, refresh tokens) -- see compose.yaml's mount comment.
/secrets/manager-mcp-oauth/
/secrets/gmail-relay-oauth/
/data/
/backups/

# Real HMAC secret lives here, copied from hooks.json.example.
/webhook/hooks.json
!/webhook/hooks.json.example
