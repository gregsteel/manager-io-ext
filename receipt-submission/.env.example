# Comma-separated Google account emails allowed to use the capture app
ALLOWED_USERS=who@gmail.com

# Google OAuth Configuration (sign-in only)
# Use a separate OAuth client from local if you want the redirect URIs kept apart.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the public HTTPS URL your browser hits, not the container's address.
GOOGLE_REDIRECT_URI=http://localhost:55666/auth/google/callback

# Sign session cookies (openssl rand -base64 32)
SESSION_SECRET=


# Directory for SQLite + receipt JPEGs (default: ./data)
# In Docker this is /app/data (bind-mounted).
DATA_DIR=

# Shared bearer between the Cloudflare Email Worker (../email-worker) and
# POST /api/inbound/email (openssl rand -base64 32). Unset = route returns 503.
INBOUND_EMAIL_SECRET=

# iOS app returns here after Google sign-in (custom URL scheme)
NATIVE_APP_REDIRECT=receipts://auth
