# MCP-access OAuth client — gates who may connect to gmail-relay as an MCP
# client at all. This is a *separate* Google Cloud OAuth client from the
# Gmail-API one in deployment/secrets/gmail/gcp-oauth.keys.json — do not reuse it here.
# Mirrors manager-mcp's MANAGER_MCP_OAUTH_GOOGLE_CLIENT_ID/SECRET.
GMAIL_RELAY_OAUTH_GOOGLE_CLIENT_ID=
GMAIL_RELAY_OAUTH_GOOGLE_CLIENT_SECRET=

# Public base URL this server is reachable at (used for the OAuth redirect).
GMAIL_RELAY_OAUTH_BASE_URL=

# Comma-separated list of Google account emails allowed to connect.
GMAIL_RELAY_ALLOWED_EMAILS=gregsteel@gmail.com
