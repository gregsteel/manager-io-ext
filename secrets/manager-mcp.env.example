# Manager API access (internal Docker URL — see root compose.yaml's MANAGER_API_URL)
MANAGER_API_KEY=your-manager-api-token-here

# Keep empty until the deployment and OAuth flow have both been verified end
# to end (spec §5, §11). Comma-separated; no wildcards.
MANAGER_MCP_WRITE_SCOPES=
MANAGER_MCP_DELETE_SCOPES=

# Google OAuth client for manager-mcp's own GoogleProvider (remote/Cowork
# access). Separate client from receipt-submission's and Manager UI's
# oauth2-proxy client — create it in Google Cloud Console with redirect URI
# https://manager-mcp.<domain>/auth/callback
MANAGER_MCP_OAUTH_GOOGLE_CLIENT_ID=
MANAGER_MCP_OAUTH_GOOGLE_CLIENT_SECRET=
MANAGER_MCP_OAUTH_BASE_URL=https://manager-mcp.<domain>

# Comma-separated emails permitted to authenticate. Google OAuth alone
# accepts any Google account that logs in; this allowlist is enforced by
# manager-mcp's AllowlistedGoogleProvider on top of it.
MANAGER_MCP_ALLOWED_EMAILS=

# Used to hit Manager /api/ and UI action endpoints (attachments + hourly
# bank-feed sync). X-API-KEY only covers /api2. This user needs Purchase
# Invoices (View, Create, Update) and Bank and Cash Accounts (View, at
# least) in Settings → User Permissions.
MANAGER_UI_USERNAME=mcp
MANAGER_UI_PASSWORD=

# Bank-feed sync interval is set in compose.yaml
# (MANAGER_MCP_BANK_FEED_SYNC_INTERVAL_SECONDS=3600), not here.

BASIQ_USERNAME=username
BASIQ_PASSWORD=