# Mirrors ../receipt-submission/.env.example — production values for the
# receipts service. See that file for field-by-field notes.

ALLOWED_USERS=you@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the public HTTPS URL the browser hits: https://receipts.<domain>/auth/google/callback
GOOGLE_REDIRECT_URI=https://receipts.<domain>/auth/google/callback

# openssl rand -base64 32
SESSION_SECRET=

NATIVE_APP_REDIRECT=receipts://auth
