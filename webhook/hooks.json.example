[
  {
    "id": "deploy-accounting",
    "execute-command": "/opt/scripts/deploy-hook.sh",
    "command-working-directory": "/repo",
    "response-message": "Deploy triggered\n",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "header",
              "name": "X-GitHub-Event"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        },
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "REPLACE_ME_WITH_RANDOM_SECRET",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        }
      ]
    }
  }
]
